import { GuiController, PomodoroController, AllTasks, Task } from "@bridge/globals.slint";
import { Style } from "style.slint";
import { FaButton, PCheckBox, Icons } from "controls.slint";

// Tag.qml
export component TagChip inherits Rectangle {
    in property <string> tag-name;
    in property <bool> is-selected: false;
    in property <bool> is-interactive: false;
    in property <string> a11y-id;
    callback clicked(string);

    visible: root.tag-name != "";
    background: GuiController.color-from-tag(root.tag-name);
    border-radius: Style.px(10);
    preferred-height: Style.px(root.is-interactive ? 24 : 14);
    max-width: self.preferred-width;
    preferred-width: label.preferred-width + Style.px(14);
    border-width: (root.is-interactive && root.is-selected) ? Style.px(2) : 0px;
    border-color: white;
    accessible-role: button;
    accessible-id: root.a11y-id;

    label := Text {
        accessible-role: text;
        accessible-id: "tagText";
        text: root.tag-name;
        color: white;
        font-size: Style.px(12);
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked(root.tag-name);
        }
    }
}

// Task.qml
export component TaskItem inherits Rectangle {
    in property <Task> task;
    in property <bool> show-tags: true;
    in property <bool> shows-tags-in-second-line: false;
    in property <bool> shows-date: true;
    in property <string> a11y-id;
    callback clicked();

    property <bool> is-pomodoro-active: PomodoroController.current-task-uuid == root.task.uuid;
    property <bool> use-small-mode: root.task.is-evening && !GuiController.is-evening;
    property <bool> held: false;
    property <string> other-tags: GuiController.other-tags(root.task.all-tags, root.task.tag-name);
    property <bool> should-show-calendar: root.task.is-from-calendar && root.task.calendar-name != "";
    property <bool> should-show-due-date: (root.task.has-due-date && root.shows-date) || root.task.has-due-date-time;
    property <bool> tags-in-second-line: root.shows-tags-in-second-line && root.other-tags != "";
    property <bool> second-line-visible: (root.should-show-calendar || root.should-show-due-date || root.tags-in-second-line) && !root.use-small-mode;

    height: root.use-small-mode ? Style.task-evening-height : Style.task-height;
    background: root.task.is-important ? Style.task-important-background : (root.task.is-evening ? Style.task-evening-background : Style.task-background);
    border-radius: 10px;
    border-width: root.is-pomodoro-active ? Style.px(2) : 0px;
    border-color: red;
    accessible-role: button;
    accessible-id: root.a11y-id;
    accessible-label: root.task.title;

    // onPressAndHold
    long-press := Timer {
        interval: 800ms;
        running: area.pressed && !root.held;
        triggered => {
            root.held = true;
            GuiController.set-task-important(root.task.uuid, !root.task.is-important);
        }
    }

    area := TouchArea {
        changed pressed => {
            if (self.pressed) {
                root.held = false;
            }
        }
        clicked => {
            if (!root.held) {
                root.clicked();
            }
        }
    }

    HorizontalLayout {
        padding-left: Style.px(10);
        padding-right: Style.px(10);
        spacing: root.use-small-mode ? Style.px(5) : Style.px(10);
        alignment: stretch;

        if !root.task.is-goal && !root.task.is-yearly: PCheckBox {
            checked: root.task.is-done;
            small-variant: root.use-small-mode;
            toggled => {
                AllTasks.set-task-done(root.task.uuid, !root.task.is-done);
            }
        }

        if root.task.is-yearly && !root.task.is-goal: FaButton {
            icon: "\u{f101}";
            icon-size: root.use-small-mode ? Style.px(14) : Style.px(18);
            icon-color: Style.icon-color;
            background-color: transparent;
            clicked => {
                AllTasks.advance-yearly-task(root.task.uuid);
            }
        }

        if root.task.is-goal: FaButton {
            icon: "\u{f11e}";
            icon-size: root.use-small-mode ? Style.px(14) : Style.px(18);
            icon-color: Style.icon-color;
            background-color: transparent;
            enabled: false;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Style.px(5);

            Rectangle {
                vertical-stretch: 1;
            }

            Rectangle {
                height: title.preferred-height;
                horizontal-stretch: 1;
                title := Text {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    text: root.task.title;
                    font-size: root.use-small-mode ? Style.px(12) : Style.px(16);
                    color: root.task.is-done ? Style.task-completed-text-color : #ffffff;
                    overflow: elide;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                }

                // font.strikeout
                if root.task.is-done: Rectangle {
                    x: 0;
                    y: (parent.height - self.height) / 2;
                    width: min(title.preferred-width, title.width);
                    height: 1px;
                    background: title.color;
                }
            }

            if root.second-line-visible: HorizontalLayout {
                spacing: Style.px(8);
                alignment: start;

                if root.should-show-calendar: Text {
                    text: "[" + root.task.calendar-name + "]";
                    font-size: Style.px(11);
                    color: root.task.is-done ? Style.task-calendar-text-disabled : #00ff00;
                }
                if root.should-show-due-date && root.task.has-due-date: Text {
                    text: root.task.due-date;
                    font-size: Style.px(11);
                    color: Style.task-secondary-text-color;
                }
                if root.tags-in-second-line: Text {
                    text: root.other-tags;
                    font-size: Style.px(11);
                    color: Style.task-secondary-text-color;
                }
            }

            Rectangle {
                vertical-stretch: 1;
            }
        }

        if root.task.has-notes: FaButton {
            icon: "\u{f249}";
            icon-color: Style.icon-color;
            background-color: transparent;
            clicked => {
                GuiController.open-notes-editor(root.task.uuid);
            }
        }

        if root.is-pomodoro-active: FaButton {
            icon: "\u{f017}";
            icon-color: Style.icon-color;
            background-color: transparent;
            clicked => {
                PomodoroController.stop();
            }
        }

        if root.show-tags && root.task.tag-name != "": VerticalLayout {
            alignment: center;
            TagChip {
                tag-name: root.task.tag-name;
                is-interactive: false;
                clicked(name) => {
                    GuiController.current-tag = name;
                    GuiController.current-page = "tasksByTag";
                }
            }
        }
    }
}
